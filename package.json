{
  "name": "aws-practitioner-for-js-fe",
  "version": "0.1.0",
  "bin": {
    "aws-practitioner-for-js-fe": "bin/aws-practitioner-for-js-fe.js"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ignore-path .gitignore --fix src",
    "prettier": "prettier src --write",
    "cdk:bootstrap": "cdk bootstrap",
    "cdk:synth": "cdk synth MyStoreAppStack",
    "cdk:deploy": "cdk deploy MyStoreAppStack --require-approval never",
    "cdk:destroy": "cdk destroy MyStoreAppStack --force",
    "site:upload": "node scripts/deploy-static-site.js upload",
    "site:invalidate": "node scripts/deploy-static-site.js invalidate",
    "site:deploy": "node scripts/deploy-static-site.js deploy",
    "site:build:upload": "npm run build && npm run site:upload",
    "site:build:deploy": "npm run build && npm run site:deploy",
    "infra:build:deploy": "npm run build && npm run cdk:deploy && npm run site:deploy"
  },
  "dependencies": {
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@mui/icons-material": "^5.8.4",
    "@mui/material": "^5.8.7",
    "@mui/styles": "^5.8.7",
    "@types/yup": "^0.29.14",
    "axios": "^0.27.2",
    "formik": "^2.2.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.1",
    "react-router-dom": "^6.3.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1030.0",
    "@aws-sdk/client-cloudfront": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/lib-storage": "^3.1030.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^14.2.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "@vitejs/plugin-react": "^1.3.2",
    "@vitest/ui": "^0.18.0",
    "aws-cdk": "^2.1118.0",
    "aws-cdk-lib": "^2.249.0",
    "c8": "^7.11.3",
    "constructs": "^10.6.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.30.1",
    "jsdom": "^20.0.0",
    "msw": "^0.43.1",
    "prettier": "2.7.1",
    "serverless": "^3.20.0",
    "serverless-finch": "^4.0.0",
    "serverless-s3-cleaner": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.7.4",
    "vite": "^2.9.13",
    "vitest": "^0.17.1"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
